%post --nochroot --interpreter=/usr/bin/python3 --erroronfail
import base64
import json
import os
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, '/usr/local/lib')
from kiosk import target_policy
root = Path('/mnt/sysroot')
payload = json.loads(base64.b64decode('@@PAYLOAD_B64@@'))
for name, item in payload.items():
    relative = Path(name)
    if relative.is_absolute() or '..' in relative.parts:
        raise ValueError('Invalid target payload path')
    path = root / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(base64.b64decode(item['data']))
    path.chmod(item['mode'])
connections = root / 'etc/NetworkManager/system-connections'
connections.mkdir(mode=0o700, parents=True, exist_ok=True)
for old in connections.glob('*.nmconnection'):
    old.unlink()
profile = connections / 'kiosk.nmconnection'
profile.write_bytes(base64.b64decode('@@NETWORK_B64@@'))
profile.chmod(0o600)
policy = json.loads(base64.b64decode('@@SERVER_POLICY_B64@@') or b'{}')
updates = policy.get('updates', target_policy.DEFAULT_UPDATES)
target_policy.write_updates(root, updates['hours'], updates['reboot'])
subprocess.run(['chroot', str(root), 'systemctl', 'enable' if updates['hours'] else 'disable',
                target_policy.TIMER], check=True)
vpn = policy.get('vpn')
if vpn:
    enable = [target_policy.write_vpn(root, vpn)]
    if vpn['kind'] == 'wireguard':
        enable.append('systemd-resolved.service')
    subprocess.run(['chroot', str(root), 'systemctl', 'enable', *enable], check=True)
target_policy.write_ssh(root, '@@SSH_PASSWORD@@')
# Decode both contract fields to verify their encoding, without printing them.
base64.b64decode('@@SSID_B64@@', validate=True)
base64.b64decode('@@PSK_B64@@', validate=True)
(root / 'etc/battery-limits-decision').write_bytes(base64.b64decode('@@BATTERY_B64@@'))
(root / 'etc/kiosk-server-user').write_text('@@USER@@\n')
(root / 'etc/vconsole.conf').write_text('KEYMAP=@@VCKEYMAP@@\nFONT=ter-v24n\n')
sudoers = root / 'etc/sudoers.d/10-server-wheel'
sudoers.write_text('%wheel ALL=(ALL) ALL\n')
sudoers.chmod(0o440)
subprocess.run(['chroot', str(root), 'visudo', '-c'], check=True)
with (root / 'etc/libvirt/libvirtd.conf').open('a') as stream:
    stream.write('\nunix_sock_group = "libvirt"\nunix_sock_rw_perms = "0770"\nauth_unix_rw = "none"\n')
# Disable modular libvirt socket activation when choosing monolithic libvirtd.
subprocess.run(['chroot', str(root), 'systemctl', 'disable', 'virtqemud.socket', 'virtqemud-ro.socket',
                'virtqemud-admin.socket', 'virtproxyd.socket', 'virtproxyd-ro.socket', 'virtproxyd-admin.socket'],
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
for unit in ('sshd.service', 'chronyd.service', 'NetworkManager.service', 'libvirtd.service',
             'podman.socket', 'fstrim.timer', 'battery-limits.timer', 'battery-guard.timer', 'server-self-check.service'):
    subprocess.run(['chroot', str(root), 'systemctl', 'enable', unit], check=True)
for unit in ('sleep.target', 'suspend.target', 'hibernate.target', 'hybrid-sleep.target',
             'suspend-then-hibernate.target'):
    subprocess.run(['chroot', str(root), 'systemctl', 'mask', unit], check=True)
# TLP is a fallback tool, not a competing boot-time policy daemon.
subprocess.run(['chroot', str(root), 'systemctl', 'disable', 'tlp.service'], check=True)
subprocess.run(['chroot', str(root), 'systemctl', 'set-default', 'multi-user.target'], check=True)
subprocess.run(['chroot', str(root), 'restorecon', '-RF', '/etc', '/usr/local'], check=True)
%end
